ASR_BIND=0.0.0.0:15000
ADMIN_BIND=0.0.0.0:8080

DEFAULT_MODEL_ID=large-v3
MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3.bin
MODEL_PATH=/models/ggml-large-v3.bin

LANGUAGE=fi
N_THREADS=8
BEAM_SIZE=3

# Silero VAD V5 via voice_activity_detector crate.
VAD_THRESHOLD=0.55
MIN_SEGMENT_SECONDS=1.0
MAX_SEGMENT_SECONDS=30.0
SILENCE_CUT_SECONDS=1.2
PRE_ROLL_SECONDS=0.4

CONFIG_PATH=/config/config.json
OUTPUT_JSONL=/output/transcripts.jsonl
WEBHOOK_TIMEOUT_MS=3000
RUST_LOG=info
AUDIO2MQTT_LOG_LEVEL=info
